# Yatharth Music AI configuration
# Demo is safe for UI testing; set false only when an ACE-Step server is reachable.
DEMO_MODE=true
MUSIC_ENGINE_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
POLL_SECONDS=2
POLL_TIMEOUT_SECONDS=300
MAX_CONCURRENT_GENERATIONS=2
RATE_LIMIT_PER_MINUTE=10
MAX_TASKS_IN_MEMORY=2000
# Replace with your real frontend origin(s) in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
